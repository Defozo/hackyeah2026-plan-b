{
  "name": "plan-b",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5181 --strictPort",
    "dev:api": "tsx apps/api/main.ts",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4181 --strictPort",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\" \"*.{ts,json,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\" \"*.{ts,json,yaml}\""
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@garmin/fitsdk": "21.217.0",
    "@js-temporal/polyfill": "0.5.1",
    "@react-pdf/renderer": "4.9.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/pol": "1.0.0",
    "dexie": "4.4.6",
    "fastify": "5.12.5",
    "groq-sdk": "1.6.0",
    "ical.js": "2.2.1",
    "lucide-react": "1.51.0",
    "luxon": "3.7.2",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "agent-browser": "0.38.2",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
